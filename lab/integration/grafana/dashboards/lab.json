{
  "title": "4–5장 외부 연동 실험",
  "uid": "integration-lab",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 연결 사용/대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "integration"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_http_pool_leased",
          "refId": "A",
          "legendFormat": "{{instance}} {{uri}} lab_http_pool_leased"
        },
        {
          "expr": "lab_http_pool_pending",
          "refId": "B",
          "legendFormat": "{{instance}} {{uri}} lab_http_pool_pending"
        }
      ]
    },
    {
      "id": 2,
      "title": "DB 연결 사용/대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "integration"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "refId": "A",
          "legendFormat": "{{instance}} {{uri}} hikaricp_connections_active"
        },
        {
          "expr": "hikaricp_connections_pending",
          "refId": "B",
          "legendFormat": "{{instance}} {{uri}} hikaricp_connections_pending"
        }
      ]
    },
    {
      "id": 3,
      "title": "포인트 수신/반영 누적",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "integration"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_points_received_total",
          "refId": "A",
          "legendFormat": "{{instance}} {{uri}} lab_points_received_total"
        },
        {
          "expr": "lab_points_applied_total",
          "refId": "B",
          "legendFormat": "{{instance}} {{uri}} lab_points_applied_total"
        }
      ]
    },
    {
      "id": 4,
      "title": "비동기 작업 실행/대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "integration"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "lab_async_active",
          "refId": "A",
          "legendFormat": "{{instance}} {{uri}} lab_async_active"
        },
        {
          "expr": "lab_async_queued",
          "refId": "B",
          "legendFormat": "{{instance}} {{uri}} lab_async_queued"
        }
      ]
    },
    {
      "id": 5,
      "title": "요청 처리 스레드",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "integration"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "tomcat_threads_busy_threads",
          "refId": "A",
          "legendFormat": "{{instance}} {{uri}} tomcat_threads_busy_threads"
        }
      ]
    },
    {
      "id": 6,
      "title": "서버 응답 p95 (초)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "integration"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, instance, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "{{instance}} {{uri}} histogram_quantile(0.95, sum by (le, instance, uri) (rate(http_server_requests_seconds_bucket[1m])))"
        }
      ]
    }
  ]
}
